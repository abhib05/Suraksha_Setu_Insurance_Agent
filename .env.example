# Copy to .env and fill in. Never commit .env.

# Meta Model API (Standard mode only; never a -contributor model ID)
MODEL_API_KEY=
MODEL_BASE_URL=https://api.meta.ai/v1

# live: call the API · record: call and save responses · replay: use saved responses only (tests, CI)
LLM_MODE=replay
LLM_RECORDINGS_DIR=evals/recordings

# Postgres (docker compose maps it to host port 5433)
DATABASE_URL=postgresql+psycopg://suraksha:suraksha@localhost:5433/suraksha

# Temporal dev server (docker compose)
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=suraksha

# Fernet key for the identity vault. Generate with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VAULT_KEY=

# Local document store
DOCSTORE_DIR=data/documents

# Mock partner portal (R0 filing target)
PORTAL_BASE_URL=http://localhost:8100
# Worker agents: live (chat intake + model), demo (case A fixtures, files with the mock
# portal, no model), stub (fixtures only, no portal)
AGENTS=live

# Spend guard for the $150 hackathon credits (USD); calls stop when the logged total passes it
LLM_SPEND_LIMIT_USD=120
